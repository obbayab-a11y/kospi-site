# ─────────────────────────────────────────────────────────────
# KOSPI 공포·탐욕지수 환경변수 (모두 선택 사항 — 없으면 demo 모드로 실행)
# 사용: cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# demo: 시뮬레이션 데이터 (기본값, API 키 불필요)
# live: KRX Open API 실데이터
DATA_MODE=demo

# KRX Open API 인증키 (https://openapi.krx.co.kr 에서 발급 후 서비스별 이용 신청)
KRX_API_KEY=
# KRX_API_BASE_URL=https://data-dbg.krx.co.kr
# KRX 과거 응답 파일 캐시 위치
KRX_CACHE_DIR=.cache/krx

# 외국인 순매수 CSV (date,netBuy[억원]) — KRX Open API는 투자자별 매매동향 미제공
# FOREIGN_FLOW_CSV=./data/foreign-flow.csv

# 계산 결과 저장소: memory(기본) | prisma
STORE_DRIVER=memory
# STORE_DRIVER=prisma 일 때 사용 (PostgreSQL: postgresql://user:pass@host:5432/db)
DATABASE_URL="file:./dev.db"

# 정규화 lookback (년)
LOOKBACK_YEARS=5

# 데모 모드에서 장애를 흉내 낼 Provider (쉼표 구분)
# 예: putCall,foreignFlow → 해당 지표 제외 + 가중치 재분배 동작 확인
# DEMO_FAIL_FACTORS=

# 사이트 URL (OpenGraph·sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
